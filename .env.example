# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.
# Supabase 프로젝트 → Connect 버튼에서 연결 주소를 복사합니다.

# 앱 실행용: Transaction pooler (포트 6543), 끝에 ?pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 마이그레이션용: Session pooler 또는 Direct connection (포트 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# 세션 쿠키 서명용 임의 문자열 (32바이트 이상 권장)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# 선택
# PORT=4317
# HOST=127.0.0.1
