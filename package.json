{
  "name": "pick-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PICK 매거진 카드뉴스 다중 사용자 웹 서비스 (고급웹프로그래밍 기말 프로젝트)",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "legacy": "node legacy/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/migrate-json.mjs",
    "postinstall": "prisma generate",
    "db:password": "node scripts/set-db-password.mjs",
    "test:db": "node --env-file-if-exists=.env --test --test-timeout=60000 tests/db/*.test.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
